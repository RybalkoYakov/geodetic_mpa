---
import PageLayout from '../layouts/PageLayout.astro';
import PageTitle from "../components/PageTitle.astro";
import Form from "../components/Form.astro";
---

<PageLayout
	title="Геодезические услуги в Минске"
	description="Добро пожаловать на наш сайт геодезических услуг! Мы предоставляем широкий спектр высококачественных геодезических услуг для различных отраслей и проектов. Наша команда опытных специалистов обеспечит точные измерения, надежные данные и эффективные решения для ваших проектов."
	keyWords="геодезические услуги, геодезические услуги минск, топографическая съемка, топография участка, инжинерные изыскания, исполнительня съемка"
>
	<section class="hero_section">

	</section>

	<section class="services_section">
		<h2>Наши услуги</h2>
	</section>

	<section class="about_us_section">
		<h2>О нас</h2>
	</section>

	<section class="rewieus_section">
		<h2>Отзывы о нас</h2>
	</section>

	<section class="make_order_section">
		<h2>Связаться с нами</h2>
		<Form/>
	</section>
</PageLayout>

<style>
	.hero_section {
		display: flex;
		justify-content: center;
		flex-direction: column;
	}

	.subtitle {
		font-size: 18px;
		text-align: center;
		margin-bottom: 50px;
	}

	.hero_section__container {
		margin-top: 20px;
		display: grid;
		grid-column-gap: 20px;
		grid-row-gap: 40px;
		grid-template-columns: 1fr 1fr 1fr;
	}

	.text_container {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.text_container > p {
		font-size: 15px;
		text-align: justify;
	}

	.button_container {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.button_container > a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 250px;
		height: 60px;
		border: 2px solid #ef4444;
		border-radius: 5px;
		font-size: 22px;
		transition: all linear .3s;
		cursor: pointer;
		font-weight: bold;
	}

	.button_container > a:hover {
		background-color: #ef4444;
		color: #ffffff;
		border-color: #ffffff;
	}

	.img_container {
		display: flex;
		justify-content: flex-end;
	}

	.hero_section__container > div > img {
		width: 300px;
		height: 300px;
		display: inline-block;
	}

	@media (max-width: 1000px) {
		.hero_section__container {
			grid-template-columns: 1fr;
		}

		.img_container {
			justify-content: center;
		}
	}
</style>
