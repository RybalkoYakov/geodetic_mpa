        <ServiceCard/>
        <ServiceCard/>
        <ServiceCard/>
        <ServiceCard/>
        <ServiceCard/>
        <ServiceCard/>
        <ServiceCard/>
    </ul>
</PageLayout>

<style>
    .service_cards {
        width: 100%;
        height: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 70px;
        justify-content: center;
        align-items: center;
        margin-bottom: 50px;
    }

     @media (max-width: 700px) {
         .service_cards {
             margin-top: 50px;
         }
     }
</style>