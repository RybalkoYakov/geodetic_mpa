---
import PageLayout from "../../layouts/PageLayout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
---


<PageLayout
    title="Наши услуги"
    description="Услуги компании 'Геодезические услуги'"
    keyWords="топографическая съемка, топография участка"
>
    <ul class="service_cards">
        <ServiceCard
            title="Топография"
            img="/service_cards_images/service_card_image.gif"
            alt="топографический план"
            desc="Геодезический процесс получения точных данных о рельефе и объектах местности для картографии, инженерии, планирования и научных исследований."
            link="/services/topography"
        />
        <ServiceCard
            title="Исполнительные чертежи"
            img="/service_cards_images/working_drawing_image.gif"
            alt="мост в графическом стиле"
            desc="Детализированные технические рисунки, передающие спецификации и инструкции для строительства и производства с учетом размеров, материалов и конструкции."
            link="/services/working_drawing"
        />
        <ServiceCard
            title="Вынос проектов"
            img="/service_cards_images/project_to_world_image.gif"
            alt="инженер за работой"
            desc="Процесс переноса планов и измерений инженерного проекта на реальный местный рельеф для строительных и геодезических работ."
            link="/services/project_field_layout"
        />
        <ServiceCard
            title="Геодезическая поддержка"
            img="/service_cards_images/geodetic_support_image.gif"
            alt="геодезическое оборудование"
            desc="Систематическое обеспечение точных геодезических данных и измерений для поддержания точности и надежности инженерных и строительных проектов."
            link="/services/geodetic_support"
        />
        <ServiceCard
            title="Границы участка"
            img="/service_cards_images/land_pot_boundaries_image.gif"
            alt=""
            desc="Установка границ земельного участка важна для определения владения, использования и предотвращения споров, обеспечивая юридическую и физическую четкость в пользовании землей."
            link="/services/land_pot_boundaries"
        />
        <ServiceCard
            title="Подземные коммуникации"
            img="/service_cards_images/underground_communications_image.gif"
            alt=""
            desc="Поиск подземных коммуникаций включает геодезические методы и технологии для обнаружения и маркировки подземных сетей, предотвращая повреждения во время строительства."
            link="/services/underground_communications"
        />

        <ServiceCard
            title="Вынос габаритов и осей"
            img="/service_cards_images/dimensions_and_axes_image.gif"
            alt=""
            desc="Процесс точного определения расположения структурных элементов на местности согласно планам и спецификациям проекта."
            link="/services/dimensions_and_axes"
        />

        <ServiceCard
            title="Специальные работы"
            img="/service_cards_images/special_works_image.gif"
            alt=""
            desc="Высокоточные измерения, мониторинг и анализ для инженерных, научных или промышленных целей, обеспечивая точность и надежность данных."
            link="/services/special_works"
        />
    </ul>
</PageLayout>

<style>
    .service_cards {
        width: 100%;
        height: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 70px;
        justify-content: center;
        align-items: center;
        margin-bottom: 50px;
    }

     @media (max-width: 700px) {
         .service_cards {
             margin-top: 50px;
         }
     }
</style>