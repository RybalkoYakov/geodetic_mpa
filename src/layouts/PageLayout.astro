---
import Header from './../components/Header.astro';
import Footer from './../components/Footer.astro';

interface PageLayoutProps {
	title: string
	description: string
	keyWords: string
	mainContainerStyle: CSSStyleSheet
}

const {
		title,
		description,
		keyWords,
		mainContainerStyle
	} = Astro.props as PageLayoutProps;
---

<!DOCTYPE html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />

		<meta name="description" content={description || ""}>
		<meta name="keywords" content={keyWords || ""} />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<meta name="theme-color" content="#1c1c1c">

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<Header/>
		<main style={mainContainerStyle || ""}>
			<slot />
			<canvas id="canvas_app_background">Ваш браузер не поддерживает технологию canvas</canvas>
		</main>
		<Footer/>
	</body>
</html>

<style is:global>
	:root {
		font-size: 10px;
		--bg-color: #1c1c1c;
		--text-color: #ef4444;

		--card-main-color: #ef4444;
		--card-shadow-color: #ef444425;
		--card-bg-color: #00000010;
	}

	* {
		margin: 0;
		padding: 0;
		border: 0;
		font-family: Roboto, sans-serif;
		box-sizing: border-box;
		-webkit-tap-highlight-color: transparent;
	}

	li {
		list-style-type: none;
	}

	a {
		text-decoration: none;
	}

	html, 
	body {
		width: 100vw;
		min-height: 100vh
	}

	body {
		display: flex;
		flex-direction: column;
		align-items: center;
		background-color: var(--bg-color);
		color: var(--text-color);
		overflow-x: hidden;
	}

	main,
	header,
	footer {
		max-width: 1920px;
		width: 100%;
		padding: 0 50px;
	}

	main {
		position: relative;
		flex: 1;
		padding: 50px;
	}

	#canvas_app_background {
		width: 100%;
		height: 100%;
		position: absolute;
		top: 0;
		left: 0;
		z-index: -5;
	}

	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: #3a3a3a;
	}

	::-webkit-scrollbar-thumb {
		background: #ef4444;
		transition: all linear .3s;
		border-radius: 3px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #ffffff;
	}

	@media screen and (max-width: 700px){
		footer,
		header,
		main {
			padding: 0 15px;
		}
	}
</style>

<script>
	const canvas = document.querySelector('#canvas_app_background') as HTMLCanvasElement;
	const canvasContainer = document.querySelector('main') as HTMLElement;

	canvas.width = parseInt(getComputedStyle(canvasContainer).width.replace('px', ''));
	canvas.height = parseInt(getComputedStyle(canvasContainer).height.replace('px', ''));

	const sceneWidth = canvas.width;
	const sceneHeight = canvas.height;

	const ctx = canvas.getContext('2d');

	const starSize = 3;
	const starColor = '#ffd400';
	const canvasBgColor = '#1c1c1c';
	const sceneArea = sceneWidth * sceneHeight;

	const stars: Star[] = [];

	interface Position {
		positionX: number
		positionY: number
	}

	interface Star {
		position: Position
		starColor: string
	}

	function getRandomPositionOnScreen() {
		const positionX = Math.round(Math.random() * sceneWidth - starSize / 2);
		const positionY = Math.round(Math.random() * sceneHeight - starSize / 2);

		return {
			positionX,
			positionY
		}
	}

	function generateStar() {
		const position = getRandomPositionOnScreen();
		ctx.fillStyle = starColor;
		ctx.fillRect(position.positionX, position.positionY, starSize, starSize);
		stars.push({position, starColor})
		return {position, starColor};
	}

	function generateStars() {
		const starsAmount = Math.round(sceneArea * 0.0001);

		for (let i = 0; i < starsAmount; i++) {
			generateStar();
		}
	}

	function moveStar(star: Star) {
		const currentPosition = star.position;

		// const incrementX = Math.random() > 0.5 ? 2 : -2;
		// const incrementY = Math.random() > 0.5 ? 2 : -2;

		const maxIncrementX = 1;
		const maxIncrementY = 5;

		const incrementX = Math.random() * maxIncrementX;
		const incrementY = Math.random() * maxIncrementY;

		const nextStarPosition : Position = {positionX: currentPosition.positionX + incrementX, positionY: currentPosition.positionY + incrementY}

		star.position = nextStarPosition;

		ctx.fillStyle = canvasBgColor;
		ctx.fillRect(currentPosition.positionX - maxIncrementX, currentPosition.positionY - maxIncrementY, starSize + 2 * maxIncrementX, starSize + 2 * maxIncrementY);

		ctx.fillStyle = starColor;
		ctx.fillRect(nextStarPosition.positionX, nextStarPosition.positionY, starSize, starSize);

		if
		(
			star.position.positionX >= sceneWidth ||
			star.position.positionX <= 0 ||
			star.position.positionY >= sceneHeight ||
			star.position.positionY <= 0
		)
		{
			ctx.fillStyle = canvasBgColor;
			ctx.fillRect(currentPosition.positionX - 2, currentPosition.positionY - 2, starSize + 4, starSize + 4);
			star.position = getRandomPositionOnScreen();
			console.log(star);
		}
	}

	generateStars();

	function moveStars() {
		for (let i = 0; i < stars.length; i++) {
			moveStar(stars[i]);
		}

		requestAnimationFrame(moveStars);
	}

	moveStars();


</script>
