---
interface PageTitleProps {
    title: string
}

const {title} = Astro.props as PageTitleProps;
---
<h1 class="service_page__title">{title}</h1>

<style>
    .service_page__title {
        font-size: 45px;
        text-align: center;
    }

    @media screen and (max-width: 700px){
        .service_page__title {
            margin-top: 50px;
        }
    }

    @media screen and (max-width: 600px){
        .service_page__title {
            font-size: 25px;
        }
    }
</style>