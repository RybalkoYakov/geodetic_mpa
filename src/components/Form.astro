<div class="form_container">
    <form class="order_form">
        <h4 class="order_form__heading">Задайте интересующий Вас вопрос заполнив форму, и мы Вам перезвоним.</h4>
        <div class="form_content">
            <div class="left_side side">
                <div class="form_input">
                    <label for="fio">ФИО</label>
                    <input id="fio" type="text">
                </div>
                <div class="form_input">
                    <label for="email">Email</label>
                    <input id="email" type="email">
                </div>
                <div class="form_input">
                    <label for="phone">Телефон</label>
                    <input id="phone" type="tel">
                </div>
            </div>
            <div class="right_side side">
                <div class="form_input">
                    <label for="message">Задайте вопрос здесь</label>
                    <textarea id="message" rows="3"></textarea>
                </div>
                <input class="form_button" type="submit">
            </div>
        </div>
    </form>
</div>

<style>
    div.form_container {
        margin-top: 40px;
        margin-bottom: 40px;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    form.order_form {
        display: flex;
        flex-direction: column;
        border: 2px solid #ef4444;
        border-radius: 5px;
        padding: 20px;
    }

    .order_form__heading {
        font-size: 20px;
        margin-bottom: 30px;
        text-align: center;
        font-weight: bold;
    }

    .form_content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-column-gap: 20px;
    }

    .side {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .form_input {
        display: flex;
        flex-direction: column;
        gap: 5px;
        width: 100%;
    }

    .form_input > input {
        height: 30px;
    }

    .form_input > label {
        font-size: 15px;
    }

    .form_input > input, .form_input > textarea {
        max-width: 98%;
        border-radius: 3px;
        font-size: 18px;
        padding: 5px;
        color: #000000;
    }

    .right_side {
        justify-content: space-between;
    }

    .form_button {
        border: 2px solid #ef4444;
        padding: 10px;
        border-radius: 5px;
        font-size: 20px;
        font-weight: bold;
        cursor: pointer;
        transition: all linear .3s;
        margin-top: 10px;
        margin-right: 10px;
    }

    .form_button:hover {
        background-color: #ef4444;
        color: #000000;
        border-color: #000000;
    }

    @media screen and (max-width: 1000px){
        .form_content {
            grid-template-columns: 1fr;
            grid-row-gap: 20px;
        }
    }

    @media screen and (max-width: 450px){
        .order_form__heading {
            font-size: 15px;
        }
    }
</style>

<script>
    const serviceId = 'service_m3h60kb';
    const templateId = 'template_p7myuqu';
    const publicKey = 'fLtmCOTLDsYtEibkF';

    import emailjs from '@emailjs/browser';
    emailjs.init(publicKey);

    const fioInput = document.querySelector('#fio') as HTMLInputElement;
    const emailInput = document.querySelector('#email') as HTMLInputElement;
    const phoneInput = document.querySelector('#phone') as HTMLInputElement;
    const messageTextarea = document.querySelector('#message') as HTMLTextAreaElement;
    const submitButton = document.querySelector('.form_button') as HTMLElement;


    submitButton.addEventListener('click', (evt) => {
        evt.preventDefault();
        const message = `Вопрос от: ${fioInput.value} \n Номер телефона: ${phoneInput.value} \n  Email: ${emailInput.value} \n Вопрос: ${messageTextarea.value}`

        function getParams() {
            return {
                name: fioInput.value,
                email: emailInput.value,
                message
            };
        }

        emailjs.send(serviceId, templateId, getParams())
            .then(res => {
                fioInput.value = '';
                emailInput.value = '';
                phoneInput.value = '';
                messageTextarea.value = '';

                alert('Message successfully sent.');


            })
            .catch(err => {
                console.log(err.message);
            })
    })




</script>