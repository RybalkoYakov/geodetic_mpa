---
    const {setBackground} = Astro.props;
---

<div
        class="
            logo_container
            w-[160px]
            h-[100px]
            my-2
            bg-stone-800
            hover:bg-stone-950
            transition
            duration-300
            rounded-xl
            cursor-pointer
            border-red-500
            flex
            justify-center
            align-middle
        "

        style=`${setBackground ? '' : 'background: transparent;'}`
>
    <a href="/">
        <img class="logo_img block w-[150px] h-[70px] ml-[5px] mt-[11px]" src="/logo_no_bg_refactored.svg" alt="our company logo">
    </a>
</div>

<style>
    @media screen and (max-width: 800px){
        div.logo_container {
            width: 112px;
            height: 70px;
        }

        div > a > img.logo_img {
            width: 105px;
            height: 49px;
            margin-left: 5px;
            margin-top: 10px;
        }
    }
</style>